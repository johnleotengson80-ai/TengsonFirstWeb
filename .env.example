FLASK_ENV=development
FLASK_DEBUG=false
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=mysql+pymysql://user:password@host:3306/database
# Or set DB_USER, DB_PASSWORD, DB_HOST, DB_PORT, and DB_NAME.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# UPLOAD_FOLDER=/path/to/local/uploads

# One-time first-admin bootstrap. Remove BOOTSTRAP_ADMIN_PASSWORD after login.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FULL_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
